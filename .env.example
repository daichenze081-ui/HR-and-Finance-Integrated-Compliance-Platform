# PeopleLedger server configuration. Copy to .env and edit locally.
# .env is git-ignored. Never commit real credentials, and never expose them to the browser.

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
PORT=4173
HOST=127.0.0.1
# Comma-separated list of allowed browser origins. Empty means same-origin only.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Database
# SQLite is the default local persistent store (Node 24+).
# Set DB_DRIVER=postgres and DATABASE_URL for PostgreSQL; memory is test-only.
# ---------------------------------------------------------------------------
DB_DRIVER=sqlite
SQLITE_PATH=var/peopleledger.sqlite
DATABASE_URL=
PGSSLMODE=disable

# ---------------------------------------------------------------------------
# Sessions
# SESSION_SECRET must be set in any shared deployment. Minimum 32 characters.
# ---------------------------------------------------------------------------
SESSION_SECRET=replace-with-a-long-random-value-at-least-32-chars
SESSION_TTL_MINUTES=480
# Seed passwords for the synthetic demo accounts. Demo data only.
SEED_PASSWORD=Demo!Passw0rd

# ---------------------------------------------------------------------------
# Evidence storage
# EVIDENCE_DRIVER=local writes to EVIDENCE_LOCAL_DIR with restrictive modes.
# EVIDENCE_DRIVER=s3 is interface-complete but reports "awaiting configuration"
# until S3_BUCKET and AWS credentials are supplied.
# ---------------------------------------------------------------------------
EVIDENCE_DRIVER=local
EVIDENCE_LOCAL_DIR=var/evidence
EVIDENCE_MAX_BYTES=5242880
S3_BUCKET=
S3_PREFIX=evidence/

# ---------------------------------------------------------------------------
# Model driver (server-side only)
# MODEL_DRIVER=bedrock  real Amazon Bedrock Converse calls signed with SigV4.
# MODEL_DRIVER=ollama   a locally hosted model reached over an HTTP loopback
#                       address. Requires OLLAMA_MODEL; the endpoint must be
#                       loopback so case data cannot be posted to a remote host.
# MODEL_DRIVER=mock     a clearly labelled deterministic stand-in that contacts
#                       nothing.
# When the requested driver cannot reach a model (no AWS credentials, no
# OLLAMA_MODEL, a non-loopback OLLAMA_URL) the server falls back to mock and
# labels every run as such rather than reporting a live model call.
# All three drivers share the same tool contract and the same AGENT_* limits.
# ---------------------------------------------------------------------------
MODEL_DRIVER=mock
AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_ANTHROPIC_VERSION=bedrock-2023-05-31
BEDROCK_MAX_TOKENS=2048
# Optional Bedrock Guardrails, applied in addition to application-level validation.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Credentials are read from the environment or the ambient AWS credential chain.
# Leave blank to use an instance/task role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---------------------------------------------------------------------------
# Locally hosted model (MODEL_DRIVER=ollama)
# OLLAMA_URL must be an HTTP loopback origin. Choose a model with tool support;
# without it the model cannot call the read-only tools and no draft is produced.
# ---------------------------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_CONTEXT_TOKENS=8192

# ---------------------------------------------------------------------------
# Agent limits. Shared by every model driver, including ollama.
# ---------------------------------------------------------------------------
AGENT_MAX_TOOL_CALLS=8
AGENT_STEP_TIMEOUT_MS=30000
AGENT_RUN_TIMEOUT_MS=120000
AGENT_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Simulated Microsoft Teams scheduling
# No Graph API call is made. Set INTERVIEW_FORCE_FAILURE=1 to demonstrate
# visible failure states.
# ---------------------------------------------------------------------------
INTERVIEW_PROVIDER=simulated-teams
INTERVIEW_FORCE_FAILURE=0
