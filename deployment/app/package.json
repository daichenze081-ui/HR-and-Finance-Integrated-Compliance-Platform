{
  "name": "people-ledger-compliance-mvp",
  "version": "2.0.0",
  "private": true,
  "description": "HR and finance review platform: Node.js API, PostgreSQL persistence, deterministic checks, Bedrock agent loop, human approvals and sealed evidence exports",
  "main": "server/index.js",
  "scripts": {
    "build": "node deployment-build.cjs",
    "check": "node check-deployment.cjs",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "migrate": "node cloud-setup.cjs migrate",
    "seed": "node cloud-setup.cjs seed",
    "setup": "node cloud-setup.cjs all"
  },
  "dependencies": {
    "pg": "8.13.1",
    "@vercel/blob": "2.8.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0"
}
